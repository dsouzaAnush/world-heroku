WORKFLOW_TARGET_WORLD="@anushdsouza/world-heroku"
DATABASE_URL="postgres://world:world@localhost:5432/world"

# Tune these together against the connection limit of your Postgres plan.
WORKFLOW_HEROKU_WORKER_CONCURRENCY="10"
WORKFLOW_HEROKU_MAX_POOL_SIZE="10"

# Set this when multiple applications intentionally share one database.
# WORKFLOW_HEROKU_JOB_PREFIX="my-app"
